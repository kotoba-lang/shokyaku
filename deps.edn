{:paths ["src"]
 ;; Deliberately dependency-free, for the same reason `kotoba-lang/taxlaw`
 ;; and `kotoba-lang/worklaw` are: an actor that needs to know how an asset
 ;; depreciates should not thereby acquire a ledger, a country registry, or
 ;; a network client.
 ;;
 ;; The 耐用年数 and 償却率 tables are not a dependency either. They are
 ;; embedded as a generated projection (`tools/gen-embedded.cljs`, with a
 ;; `--check` gate) rather than read from `resources/` at runtime, because a
 ;; cwd-relative resource read works only while this library is the root
 ;; project — measured in `kotoba-lang/technology` on 2026-08-18.
 ;;
 ;; The e-Gov corpus (`kotoba-lang/jp.go.e-gov.elaws`) is not a dependency.
 ;; `tools/verify_citations.cljs` reads its index when it is present on disk
 ;; and refuses to report a verdict when it is not — verification is an
 ;; operator's step, not something a consumer carries.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       }
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
